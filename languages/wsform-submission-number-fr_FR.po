#. Plugin Name of the plugin
#: wsform-submission-number.php
#: wsform-submission-number.php:59
msgid "Submission Numbers for WS Form"
msgstr "Submission Numbers for WS Form"

#. Plugin URI of the plugin
#: wsform-submission-number.php
msgid "https://github.com/willybahuaud/wsform-submission-number"
msgstr ""

#. Description of the plugin
#: wsform-submission-number.php
msgid "Gives each WS Form submission a readable, continuous number, such as DEV-2026-0042, from sequences shared or not between forms."
msgstr "Donne à chaque soumission WS Form un numéro lisible et continu, par exemple DEV-2026-0042, à partir de séquences partagées ou non entre formulaires."

#. Author of the plugin
#: wsform-submission-number.php
msgid "Willy Bahuaud"
msgstr ""

#. Author URI of the plugin
#: wsform-submission-number.php
msgid "https://wabeo.fr/"
msgstr ""

#: includes/admin/class-notices.php:55
msgid "Sequence saved."
msgstr "Séquence enregistrée."

#: includes/admin/class-notices.php:58
msgid "Sequence deleted."
msgstr "Séquence supprimée."

#: includes/admin/class-notices.php:80
msgid "Give the sequence a name."
msgstr "Donnez un nom à la séquence."

#: includes/admin/class-notices.php:81
msgid "The format needs {N}, the number itself."
msgstr "Le format doit contenir {N}, le numéro lui-même."

#: includes/admin/class-notices.php:82
msgid "A sequence that resets every year or month needs the year in its format, {YYYY} or {YY}, or the same number would come back."
msgstr "Une séquence remise à zéro chaque année ou chaque mois doit avoir l'année dans son format, {YYYY} ou {YY}, sinon le même numéro reviendrait."

#: includes/admin/class-notices.php:83
msgid "A sequence that resets every month needs {MM} in its format, or the same number would come back."
msgstr "Une séquence remise à zéro chaque mois doit avoir {MM} dans son format, sinon le même numéro reviendrait."

#: includes/admin/class-notices.php:84
msgid "This sequence already gave numbers: its reset rule can no longer change. Create a new sequence instead."
msgstr "Cette séquence a déjà donné des numéros : sa remise à zéro ne peut plus changer. Créez plutôt une nouvelle séquence."

#: includes/admin/class-notices.php:85
msgid "The next number must be higher than the last number given in this period, or the same number would be given twice."
msgstr "Le prochain numéro doit être plus grand que le dernier numéro donné dans cette période, sinon le même numéro serait donné deux fois."

#: includes/admin/class-notices.php:86
msgid "The next number skips some values: those numbers will never be given."
msgstr "Le prochain numéro saute des valeurs : ces numéros ne seront jamais donnés."


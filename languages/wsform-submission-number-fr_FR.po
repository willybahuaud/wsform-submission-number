msgstr "Cette séquence a déjà donné des numéros : sa remise à zéro est verrouillée."

#: templates/sequence-edit.php:88
msgid "First number of each new period"
msgstr "Premier numéro de chaque nouvelle période"

#: templates/sequence-edit.php:92
#: templates/sequences-list.php:62
#: templates/sequences-list.php:99
msgid "Next number"
msgstr "Prochain numéro"

#: templates/sequence-edit.php:98
msgid "No number given yet in the current period. Taking over from another tool? Enter the number to continue from."
msgstr "Aucun numéro donné pour l'instant dans la période en cours. Vous prenez la suite d'un autre outil ? Indiquez le numéro à partir duquel continuer."

#. translators: %s: last number given.
#: templates/sequence-edit.php:102
#, php-format
msgid "Last number given in the current period: %s. The next number can only go up."
msgstr "Dernier numéro donné dans la période en cours : %s. Le prochain numéro ne peut que monter."

#: templates/sequence-edit.php:108
msgid "This skips some numbers: they will never be given."
msgstr "Des numéros sont sautés : ils ne seront jamais donnés."

#: templates/sequence-edit.php:109
msgid "Too low: this number was already given."
msgstr "Trop bas : ce numéro a déjà été donné."


#. translators: 1: number token, 2: number token with padding, 3: date tokens, 4: example format.
#: templates/sequence-edit.php:56
#, php-format
msgid "%1$s is the number, padded to the digits below, %2$s pads it to 6 digits. %3$s are the year, short year, month and day the number is given. Anything else stays as typed, for example %4$s."
msgstr "%1$s est le numéro, complété selon le nombre de chiffres ci-dessous, %2$s le met sur 6 chiffres. %3$s sont l'année, l'année courte, le mois et le jour où le numéro est donné. Le reste est gardé tel quel, par exemple %4$s."

#: templates/sequence-edit.php:67
msgid "Digits"
msgstr "Chiffres"

#: templates/sequence-edit.php:70
msgid "Zeros added in front of {N}: 4 gives 0042. A longer number is never cut."
msgstr "Zéros ajoutés devant {N} : 4 donne 0042. Un nombre plus long n'est jamais coupé."

#: templates/sequence-edit.php:74
#: templates/sequences-list.php:60
msgid "Reset"
msgstr "Remise à zéro"

#: templates/sequence-edit.php:83
